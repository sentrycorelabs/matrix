FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

# PHP 8.5 ships in the native Ubuntu 26.04 archive — no PPA needed
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    php8.5-cli \
    php8.5-common \
    php8.5-mbstring \
    php8.5-xml \
    php8.5-curl \
    php8.5-zip \
    php8.5-mysql \
    php8.5-pgsql \
    php8.5-sqlite3 \
    php8.5-redis \
    php8.5-gd \
    php8.5-intl \
    php8.5-bcmath \
    php8.5-tokenizer \
    php8.5-dom \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
